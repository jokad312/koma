# Dépendances et builds
node_modules/
.next/
out/
build/
dist/
coverage/

# Secrets : ne jamais envoyer sur GitHub
.env
.env.*
!.env.example

# Exports et sauvegardes : jamais dans le dépôt public (données clients)
exports/
sauvegardes/
backups/
*.dump
*.backup
*.bak
supabase/.temp/
supabase/.branches/

# Documentation des prestataires tirée des espaces marchands : lue en local, jamais publiée
# (règle 4 : aucune donnée marchande ; règle 6 : aucun fichier tiers sans licence vérifiée)
docs/references/paiements/

# Sakura Town : jamais dans le dépôt public tant que la licence webfont n'est pas confirmée (Q-F1, règle 6)
public/fonts/

# Réglages personnels
_bmad/custom/*.user.toml
.claude/settings.local.json

# Système
.DS_Store
Thumbs.db
*.log

# Tests et outils
test-results/
playwright-report/
*.tsbuildinfo
next-env.d.ts

# KOMA SHOP — variables d'environnement (noms seulement, jamais de valeur ici)
# Valeurs réelles : .env.local en local, variables d'environnement de l'application Node.js sur Hostinger en production.
# Chaque story qui ajoute une variable la déclare ici et dans src/lib/env.ts.

# Site (adresse publique, jamais en dur : http://localhost:3000 en local, domaine Q-D1 en production)
NEXT_PUBLIC_SITE_URL=

# Titres de vitrine en Sakura Town (true/false, éteint par défaut : Q-F1, fichier sous licence requis dans public/fonts/sakura-town.otf)
NEXT_PUBLIC_TITRES_SAKURA=

# Déploiement seulement (jamais lu par le site, hors env.ts) : true (ou 1) uniquement sur Hostinger. Le build de production échoue alors
# tant qu'un texte « [Texte à fournir] » reste dans une page publique. Absente de la CI, du dev et du build local.
KOMA_VERIFIER_TEXTES=

# Supabase (koma-dev en local, projet de production sur Hostinger)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Tests e2e seulement (jamais lu par le site) : boîte de test de la base Supabase locale (Mailpit, port 54324 de supabase start).
# Laisser vide sur koma-dev : les tests de connexion sont alors ignorés.
MAILPIT_URL=

# Tâches planifiées (même valeur dans Supabase Vault)
CRON_SECRET=

# Cookie signé du panier
PANIER_COOKIE_SECRET=

# Lien de désinscription des Emails commerciaux (story 9.4) : clé HMAC, 32 caractères au moins, aléatoire.
# Ne jamais la changer en production sans raison : les liens déjà envoyés cesseraient de fonctionner.
DESINSCRIPTION_SECRET=

# Emails (Resend ; domaine du site : Q-D1, configuré dans la story de mise en ligne)
# EMAIL_EXPEDITEUR : adresse d'expédition acceptée par Resend (sans domaine, celle de test de Resend ; les emails vont alors à l'adresse du titulaire du compte Resend)
RESEND_API_KEY=
EMAIL_EXPEDITEUR=

# Bunny Stream : bibliothèque privée (vidéos de kit) ; détail dans docs/bunny-stream-prive.md
# BUNNY_PRIVE_API_KEY : « API Key » complète de la bibliothèque (Stream > bibliothèque > API), PAS la clé en lecture seule.
# BUNNY_PRIVE_TOKEN_KEY : « Url token authentication Key » de la Pull Zone de la bibliothèque (Stream > bibliothèque > API > Pull zone > Security > Token authentication).
#   Ce n'est ni la clé API, ni la clé « Token authentication » de l'onglet Security de la bibliothèque (celle-ci sert au lecteur intégré, non utilisé).
#   Ne pas inverser API_KEY et TOKEN_KEY : les adresses signées seraient refusées (corrigé le 2026-11-08, voir la doc).
# BUNNY_PRIVE_CDN_HOSTNAME : nom d'hôte (xxx.b-cdn.net) de cette même Pull Zone.
BUNNY_PRIVE_LIBRARY_ID=
BUNNY_PRIVE_API_KEY=
BUNNY_PRIVE_TOKEN_KEY=
BUNNY_PRIVE_CDN_HOSTNAME=

# Bunny Stream : bibliothèque publique (héros, extraits)
BUNNY_PUBLIC_LIBRARY_ID=
BUNNY_PUBLIC_API_KEY=
NEXT_PUBLIC_BUNNY_PUBLIC_CDN_HOSTNAME=

# PawaPay (API v2)
PAWAPAY_API_URL=
PAWAPAY_API_TOKEN=

# Polar (paniers 100 % kits)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=

# MaishaPay (mobile money et carte) : clés de l'application « KOMA SHOP » créée chez MaishaPay (menu « Développeur »), jamais celles d'une autre application.
# Mode : 0 = SANDBOX (clés MP-SBPK / MP-SBSK), 1 = LIVE (clés MP-LIVEPK / MP-LIVESK). L'adresse de l'API est fixe dans le code.
MAISHAPAY_PUBLIC_KEY=
MAISHAPAY_SECRET_KEY=
MAISHAPAY_GATEWAY_MODE=0
# PawaPay (mobile money) : jeton d'API généré dans le tableau de bord de PawaPay (menu des jetons d'API). Le bac à sable et la production ont deux comptes et deux jetons.
# Mode : sandbox ou production. L'adresse de rappel se déclare dans le tableau de bord de PawaPay : <NEXT_PUBLIC_SITE_URL>/api/paiement/notification/pawapay
PAWAPAY_API_TOKEN=
PAWAPAY_MODE=sandbox
# K-Pay et GeniusPay sont abandonnés (décisions du 2026-11-03 et du 2026-10-31) : aucune variable.

# Tests qui appellent le vrai Bunny (tests/e2e/bunny-public.spec.ts) : sautés sauf si cette variable vaut 1 (en local, à poser seulement si le compte Bunny est actif).
BUNNY_TESTS_REELS=
